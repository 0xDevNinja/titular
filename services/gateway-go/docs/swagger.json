{
  "schemes": ["http", "https"],
  "swagger": "2.0",
  "info": {
    "description": "Read-only REST surface plus SIWE / SIWS authentication for the\nTitular protocol. The gateway proxies a Postgres-backed read\nmodel populated by the indexer track and offers a parallel\nGraphQL surface (see /graphql) and SSE event stream\n(see /events). All amount and id fields that originate as\nuint256 on chain are encoded as decimal strings on the wire.\nAuthentication uses bearer tokens minted by the SIWE / SIWS\nverify endpoints; the read endpoints are public by default.",
    "title": "Titular Gateway API",
    "termsOfService": "https://github.com/0xDevNinja/titular",
    "contact": {
      "name": "Titular maintainers",
      "url": "https://github.com/0xDevNinja/titular"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "0.1.0-alpha"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "paths": {
    "/api/v1/agents": {
      "get": {
        "description": "Returns a paginated, opaque-cursor page of registered agents.\nFilterable by agent kind. Cursor is base64-encoded JSON the\nclient MUST treat as opaque and pass back unmodified.",
        "produces": ["application/json"],
        "tags": ["agents"],
        "summary": "List agents",
        "parameters": [
          {
            "type": "string",
            "description": "opaque pagination cursor; omit for the first page",
            "name": "cursor",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "page size; 1..200, default 50",
            "name": "limit",
            "in": "query"
          },
          {
            "enum": ["launchpad", "acp"],
            "type": "string",
            "description": "agent kind filter",
            "name": "kind",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.AgentsPage"
            }
          },
          "400": {
            "description": "unknown query parameter, or kind/limit out of range",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal server error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}": {
      "get": {
        "description": "Returns the registered agent identified by its primary key\n(decimal int64) or kind-qualified slug \"kind:agent_id\".",
        "produces": ["application/json"],
        "tags": ["agents"],
        "summary": "Get agent",
        "parameters": [
          {
            "type": "string",
            "description": "agent primary key or kind:agent_id slug",
            "name": "id",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/store.Agent"
            }
          },
          "404": {
            "description": "agent not found",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal server error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "get": {
        "description": "Returns a paginated, opaque-cursor page of ACP jobs.\nFilterable by phase via the `status` query parameter.",
        "produces": ["application/json"],
        "tags": ["jobs"],
        "summary": "List ACP jobs",
        "parameters": [
          {
            "type": "string",
            "description": "opaque pagination cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "page size; 1..200, default 50",
            "name": "limit",
            "in": "query"
          },
          {
            "enum": [
              "created",
              "funded",
              "active",
              "completed",
              "cancelled",
              "disputed",
              "released",
              "resolved"
            ],
            "type": "string",
            "description": "ACP job phase filter",
            "name": "status",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.JobsPage"
            }
          },
          "400": {
            "description": "unknown query parameter, or invalid status/limit",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal server error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/api/v1/stats": {
      "get": {
        "description": "Returns total agent / job / trade counters and the highest\nblock number observed by the indexer track. Cached to a few\nseconds upstream; clients SHOULD NOT poll faster than 5s.",
        "produces": ["application/json"],
        "tags": ["stats"],
        "summary": "Aggregate protocol stats",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/store.Stats"
            }
          },
          "500": {
            "description": "internal server error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/api/v1/trades": {
      "get": {
        "description": "Returns a paginated, opaque-cursor page of bonding-curve\ntrades (buy + sell). Filterable by agent token address and\nby an inclusive [from, to] window on the indexer-recorded\ncreated_at timestamp.",
        "produces": ["application/json"],
        "tags": ["trades"],
        "summary": "List trades",
        "parameters": [
          {
            "type": "string",
            "description": "opaque pagination cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "maximum": 200,
            "minimum": 1,
            "type": "integer",
            "description": "page size; 1..200, default 50",
            "name": "limit",
            "in": "query"
          },
          {
            "type": "string",
            "description": "0x-prefixed 20-byte token address",
            "name": "agent_token",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "inclusive RFC 3339 lower bound on created_at",
            "name": "from",
            "in": "query"
          },
          {
            "type": "string",
            "format": "date-time",
            "description": "inclusive RFC 3339 upper bound on created_at",
            "name": "to",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.TradesPage"
            }
          },
          "400": {
            "description": "unknown query parameter, or invalid time/limit",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal server error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "description": "Idempotently revokes the session associated with the\nAuthorization bearer token. Returns 204 whether or not the\nsession existed; the response is invariant so callers\ncannot probe for live JTIs.",
        "tags": ["auth"],
        "summary": "Revoke session",
        "responses": {
          "204": {
            "description": "session revoked or no-op"
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/auth/siwe/nonce": {
      "post": {
        "description": "Returns a fresh entropy nonce the client embeds in the\nEIP-4361 SIWE message it asks the user to sign. The nonce\nis single-use across both SIWE and SIWS verify endpoints\nand expires after a short server-controlled TTL.",
        "produces": ["application/json"],
        "tags": ["auth"],
        "summary": "Issue SIWE nonce",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.AuthNonceResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/auth/siwe/verify": {
      "post": {
        "description": "Validates an EIP-4361 SIWE message and its EVM signature\nagainst the previously issued nonce, the gateway's pinned\ndomain, and the configured chain id; on success, returns a\nbearer JWT and persists the session in Redis.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["auth"],
        "summary": "Verify SIWE message and mint session",
        "parameters": [
          {
            "description": "SIWE message and signature",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/openapi.AuthVerifyRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.AuthVerifyResponse"
            }
          },
          "400": {
            "description": "invalid_request, invalid_message, domain_mismatch, chain_mismatch, expired_message",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "401": {
            "description": "invalid_nonce or invalid_signature",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/auth/siws/nonce": {
      "post": {
        "description": "Returns a fresh entropy nonce the client embeds in the\nSIWS (Sign-In With Solana) message it asks the user to\nsign. The nonce is single-use across both SIWE and SIWS\nverify endpoints and expires after a short server-controlled\nTTL.",
        "produces": ["application/json"],
        "tags": ["auth"],
        "summary": "Issue SIWS nonce",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.AuthNonceResponse"
            }
          },
          "500": {
            "description": "Internal Server Error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/auth/siws/verify": {
      "post": {
        "description": "Validates a SIWS (Sign-In With Solana) message and its\ned25519 signature against the previously issued nonce,\nthe gateway's pinned domain, and the configured Solana\ncluster; on success, returns a bearer JWT and persists\nthe session in Redis.",
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "tags": ["auth"],
        "summary": "Verify SIWS message and mint session",
        "parameters": [
          {
            "description": "SIWS message and base58 signature",
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/openapi.AuthVerifyRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.AuthVerifyResponse"
            }
          },
          "400": {
            "description": "invalid_request, invalid_message, domain_mismatch, cluster_mismatch, expired_message, invalid_address",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "401": {
            "description": "invalid_nonce or invalid_signature",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          },
          "500": {
            "description": "internal_error",
            "schema": {
              "$ref": "#/definitions/openapi.AuthErrorResponse"
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "description": "Returns {\"status\":\"ok\"} as soon as the HTTP server is up.\nThis endpoint does NOT depend on Postgres, Redis, or NATS;\nit is intentionally a chassis-only check so orchestrators\ncan distinguish \"binary running\" from \"fully wired\".",
        "produces": ["application/json"],
        "tags": ["health"],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/openapi.HealthResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "openapi.AgentsPage": {
      "type": "object",
      "properties": {
        "data": {
          "description": "Data is the page contents in (block_number DESC, id DESC) order.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/store.Agent"
          }
        },
        "next_cursor": {
          "description": "NextCursor is the opaque pagination token. Empty on the final page.",
          "type": "string"
        }
      }
    },
    "openapi.AuthErrorBody": {
      "type": "object",
      "properties": {
        "code": {
          "description": "Code is a stable machine-readable identifier such as\n\"invalid_signature\", \"domain_mismatch\", \"rate_limited\".",
          "type": "string",
          "example": "invalid_signature"
        },
        "message": {
          "description": "Message is a short human-readable hint. MUST NOT contain values\nderived from the request body (signature bytes, recovered\naddress, internal errors).",
          "type": "string",
          "example": "signature did not verify"
        }
      }
    },
    "openapi.AuthErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/definitions/openapi.AuthErrorBody"
        }
      }
    },
    "openapi.AuthNonceResponse": {
      "type": "object",
      "properties": {
        "expires_at": {
          "description": "ExpiresAt is the unix timestamp at which the nonce will be\nrejected by /verify even if signed correctly.",
          "type": "integer",
          "example": 1714512000
        },
        "nonce": {
          "description": "Nonce is a fresh single-use entropy token bound to the upcoming\n/verify call. Hex-encoded random bytes.",
          "type": "string"
        }
      }
    },
    "openapi.AuthVerifyRequest": {
      "type": "object",
      "properties": {
        "message": {
          "description": "Message is the EIP-4361 (SIWE) or analogous SIWS message string,\nverbatim — clients MUST NOT pre-parse and re-serialise it.",
          "type": "string"
        },
        "signature": {
          "description": "Signature is hex-encoded for SIWE (0x-prefixed, 65 bytes) and\nbase58 for SIWS (64-byte ed25519 signature).",
          "type": "string"
        }
      }
    },
    "openapi.AuthVerifyResponse": {
      "type": "object",
      "properties": {
        "address": {
          "description": "Address is the lowercase 0x-hex EVM address (SIWE) or base58\nSolana pubkey (SIWS) the token was issued to.",
          "type": "string"
        },
        "expires_at": {
          "description": "ExpiresAt is the unix timestamp the token expires at.",
          "type": "integer",
          "example": 1714598400
        },
        "token": {
          "description": "Token is the bearer JWT to attach as Authorization: Bearer \u003ctoken\u003e.",
          "type": "string"
        }
      }
    },
    "openapi.HealthResponse": {
      "type": "object",
      "properties": {
        "status": {
          "description": "Status is always \"ok\" when the gateway is serving.",
          "type": "string",
          "example": "ok"
        }
      }
    },
    "openapi.JobsPage": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/store.Job"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "openapi.TradesPage": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/store.Trade"
          }
        },
        "next_cursor": {
          "type": "string"
        }
      }
    },
    "store.Agent": {
      "type": "object",
      "properties": {
        "agent_id": {
          "description": "on-chain uint256, decimal",
          "type": "string"
        },
        "block_number": {
          "type": "integer"
        },
        "capabilities": {
          "description": "bitmap as decimal",
          "type": "string"
        },
        "controller": {
          "description": "0x-hex (ACP)",
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "creator": {
          "description": "0x-hex (launchpad)",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "kind": {
          "$ref": "#/definitions/store.AgentKind"
        },
        "log_index": {
          "type": "integer"
        },
        "metadata_uri": {
          "description": "optional",
          "type": "string"
        },
        "tx_hash": {
          "description": "0x-hex",
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "store.AgentKind": {
      "type": "string",
      "enum": ["launchpad", "acp"],
      "x-enum-varnames": ["AgentKindLaunchpad", "AgentKindACP"]
    },
    "store.Job": {
      "type": "object",
      "properties": {
        "agent_id": {
          "description": "on-chain uint256",
          "type": "string"
        },
        "agent_pk": {
          "type": "integer"
        },
        "block_number": {
          "type": "integer"
        },
        "budget": {
          "type": "string"
        },
        "clone_address": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "job_type": {
          "type": "integer"
        },
        "log_index": {
          "type": "integer"
        },
        "on_chain_id": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/definitions/store.JobPhase"
        },
        "principal": {
          "type": "string"
        },
        "result_uri": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "tx_hash": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "store.JobPhase": {
      "type": "string",
      "enum": [
        "created",
        "funded",
        "active",
        "completed",
        "cancelled",
        "disputed",
        "released",
        "resolved"
      ],
      "x-enum-varnames": [
        "JobPhaseCreated",
        "JobPhaseFunded",
        "JobPhaseActive",
        "JobPhaseCompleted",
        "JobPhaseCancelled",
        "JobPhaseDisputed",
        "JobPhaseReleased",
        "JobPhaseResolved"
      ]
    },
    "store.Stats": {
      "type": "object",
      "properties": {
        "last_block_indexed": {
          "type": "integer"
        },
        "total_agents": {
          "type": "integer"
        },
        "total_jobs": {
          "type": "integer"
        },
        "total_trades": {
          "type": "integer"
        }
      }
    },
    "store.Trade": {
      "type": "object",
      "properties": {
        "agent_in": {
          "type": "string"
        },
        "agent_out": {
          "type": "string"
        },
        "agent_token_pk": {
          "type": "integer"
        },
        "block_number": {
          "type": "integer"
        },
        "created_at": {
          "type": "string"
        },
        "curve": {
          "type": "string"
        },
        "fee": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "log_index": {
          "type": "integer"
        },
        "quote_in": {
          "type": "string"
        },
        "quote_out": {
          "type": "string"
        },
        "side": {
          "description": "\"buy\" | \"sell\"",
          "type": "string"
        },
        "trader": {
          "type": "string"
        },
        "tx_hash": {
          "type": "string"
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "description": "Bearer token issued by POST /auth/siwe/verify or /auth/siws/verify.",
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  }
}
