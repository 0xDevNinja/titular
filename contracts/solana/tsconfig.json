{
  "compilerOptions": {
    "types": ["mocha", "chai"],
    "lib": ["es2022"],
    "module": "commonjs",
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "target/ts",
    "rootDir": "."
  },
  "include": ["tests/**/*.ts", "migrations/**/*.ts"],
  "exclude": ["node_modules", "target"]
}
